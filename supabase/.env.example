# Segredos do Supabase LOCAL, lidos pelo `env()` do supabase/config.toml.
# Copie para supabase/.env (ignorado pelo Git) e preencha com o OAuth App
# de DESENVOLVIMENTO do GitHub (callback http://127.0.0.1:54321/auth/v1/callback).
# Só a CLI do Supabase lê este arquivo; o Next não o carrega.
# Sem estes valores a CLI sobe mesmo assim, mas o login falha na tela do GitHub.
SUPABASE_AUTH_EXTERNAL_GITHUB_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GITHUB_SECRET=
