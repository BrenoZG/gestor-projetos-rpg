# Copie para .env.local e preencha. NUNCA commite o .env.local.

# Supabase (local: valores impressos por `npm run db:start`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=cole-a-anon-key-aqui

# IDs numéricos de contas GitHub autorizadas, separados por vírgula.
# Descubra o seu com: gh api user --jq .id
ALLOWLIST_GITHUB_IDS=000000

# Segredo do cron de keepalive (gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
CRON_SECRET=
