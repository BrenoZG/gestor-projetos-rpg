# Copie para .env.local e preencha. NUNCA commite o .env.local.

# Supabase (local: valores impressos por `npm run db:start`, campos API_URL e PUBLISHABLE_KEY)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=cole-a-publishable-key-aqui

# IDs numéricos de contas GitHub autorizadas, separados por vírgula.
# Descubra o seu com: gh api user --jq .id
ALLOWLIST_GITHUB_IDS=000000
